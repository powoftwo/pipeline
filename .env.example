# Redis / BullMQ
REDIS_URL=redis://localhost:6379
QUEUE_NAME=video-processing

# S3 / RustFS Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_CONSOLE_URL=http://localhost:9001
S3_ACCESS_KEY=admin
S3_SECRET_KEY=adminpassword
S3_REGION=us-east-1
S3_BUCKET_RAW=videos-raw
S3_BUCKET_PROCESSED=videos-processed

# Processing configuration
TEMP_DIR=/tmp/video-processing
HLS_SEGMENT_TIME=4
COMPUTE_QUALITY_METRICS=true
COMPUTE_VMAF=true
COMPUTE_XPSNR=true

# TUS Resumable Upload
TUS_UPLOAD_DIR=/tmp/video-processing/tus_uploads
TUS_MAX_SIZE=10737418240

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
